        <PackageReference Include="Npgsql" Version="8.0.9"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Rebalancer.Core\Rebalancer.Core.csproj"/>
        <ProjectReference Include="..\Rebalancer.LeaseCoordination\Rebalancer.LeaseCoordination.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Rebalancer.UnitTests"/>
        <InternalsVisibleTo Include="Rebalancer.IntegrationTests"/>
    </ItemGroup>

</Project>
