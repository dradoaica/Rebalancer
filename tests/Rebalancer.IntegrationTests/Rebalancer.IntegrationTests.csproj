<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <LangVersion>default</LangVersion>
        <RootNamespace>Rebalancer.IntegrationTests</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1"/>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0"/>
        <PackageReference Include="StackExchange.Redis" Version="3.4.29" />
        <PackageReference Include="StackExchange.Redis.DataTypes" Version="2.0.0"/>
        <PackageReference Include="Testcontainers.MsSql" Version="4.16.0"/>
        <PackageReference Include="Testcontainers.PostgreSql" Version="4.16.0"/>
        <PackageReference Include="Testcontainers.Redis" Version="4.16.0"/>
        <PackageReference Include="Xunit.SkippableFact" Version="1.5.85"/>
        <PackageReference Include="ZooKeeperNetEx" Version="3.4.12.4"/>
        <PackageReference Include="xunit" Version="2.9.3"/>
        <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\Rebalancer.Core\Rebalancer.Core.csproj"/>
        <ProjectReference Include="..\..\src\Rebalancer.Extensions.Diagnostics.HealthChecks\Rebalancer.Extensions.Diagnostics.HealthChecks.csproj"/>
        <ProjectReference Include="..\..\src\Rebalancer.PostgreSql\Rebalancer.PostgreSql.csproj"/>
        <ProjectReference Include="..\..\src\Rebalancer.Redis\Rebalancer.Redis.csproj"/>
        <ProjectReference Include="..\..\src\Rebalancer.SqlServer\Rebalancer.SqlServer.csproj"/>
        <ProjectReference Include="..\..\src\Rebalancer.ZooKeeper\Rebalancer.ZooKeeper.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <!-- the example's order guard, compiled in by link: it needs only Microsoft.Data.SqlClient, so the tests take no
             RabbitMQ dependency (ADR-0024) -->
        <Compile Include="..\..\examples\Rebalancer.RabbitMq.QuorumQueuesExample\ConversationGuard.cs" Link="Examples\ConversationGuard.cs"/>
    </ItemGroup>

    <ItemGroup>
        <Content Include="..\..\db\sqlserver\RebalancerSchema.sql" Link="SqlServer\RebalancerSchema.sql">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
        <Content Include="..\..\db\sqlserver\RebalancerTables.sql" Link="SqlServer\RebalancerTables.sql">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
        <Content Include="..\..\db\sqlserver\RebalancerLeastPrivilege.sql" Link="SqlServer\RebalancerLeastPrivilege.sql">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
        <!-- the shipped PostgreSQL scripts, so the tests run what operators run (US-0026, criterion 3) -->
        <Content Include="..\..\db\postgresql\*.sql" LinkBase="PostgreSql">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

    <ItemGroup>
        <!-- shared by both test projects (ADR-0022 telemetry assertions) -->
        <Compile Include="..\Rebalancer.UnitTests\TelemetryRecorder.cs">
            <Link>TelemetryRecorder.cs</Link>
        </Compile>
    </ItemGroup>

</Project>
