<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>default</LangVersion>
        <Nullable>disable</Nullable>
    </PropertyGroup>

    <!-- ADR-0024: the stream client only here; SqlClient (with the ADR-0025 Pkcs pin) for the shared turn guard -->
    <ItemGroup>
        <PackageReference Include="RabbitMQ.Stream.Client" Version="1.12.2"/>
        <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1"/>
        <!-- CVE-2026-84008: SqlClient 7.1.1 brings Pkcs 8.0.1 / 9.0.18; the highest patched line wins on every host (ADR-0025, PRB-0004) -->
        <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13"/>
    </ItemGroup>

    <!-- the same turn guard as the option A example (US-0022), compiled from its source -->
    <ItemGroup>
        <Compile Include="..\Rebalancer.RabbitMq.QuorumQueuesExample\ConversationGuard.cs" Link="ConversationGuard.cs"/>
    </ItemGroup>

</Project>
